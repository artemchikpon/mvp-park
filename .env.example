# Шаблон настроек. Скопируйте в .env и заполните пустые значения:
#   Linux/macOS:  cp .env.example .env
#   PowerShell:   Copy-Item .env.example .env
# Файл .env в git не попадает — в нём реальные пароли и секреты.

# ── База данных ──────────────────────────────────────────────────────────────
# Логин/пароль применяются только при первом создании тома pgdata.
# Если меняете пароль — поменяйте его и в DATABASE_URL.
POSTGRES_USER=face
POSTGRES_PASSWORD=face
POSTGRES_DB=face_db
DATABASE_URL=postgresql://face:face@postgres:5432/face_db

# ── HR-система с сотрудниками ────────────────────────────────────────────────
HR_API_BASE=https://central-park.rzbtech.uz

# ── API ──────────────────────────────────────────────────────────────────────
# Подпись JWT-токенов, обязательно, не короче 32 символов: openssl rand -hex 32
JWT_SECRET=
# Первый admin создаётся при старте, только пока таблица users пуста
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
# Адреса дашборда через запятую, например https://dashboard.example.com
CORS_ORIGINS=*
# Swagger (/docs). На проде — false
ENABLE_DOCS=true
